# Environment Variables

# ─── Session (required) ──────────────────────────────────────────────────────
# Min 32 characters — used to encrypt session cookies
NUXT_SESSION_PASSWORD=your-32-char-minimum-secret-key-here

# ─── Database ────────────────────────────────────────────────────────────────
# Leave unset in development — PGlite (local file DB) will be used automatically.
# In production, set this to your Neon connection string.
# DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# ─── GitHub (Phase 8 — Git integration) ─────────────────────────────────────
# Personal access token or GitHub App installation token with repo read/write
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
