# Environment Variables

# ─── Session (required) ──────────────────────────────────────────────────────
# Min 32 characters — used to encrypt session cookies
NUXT_SESSION_PASSWORD=your-32-char-minimum-secret-key-here

# ─── Database ────────────────────────────────────────────────────────────────
# Local development uses SQLite automatically at .data/db/sqlite.db.
# For production on Turso, configure both variables below in Vercel.
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# Optional libSQL-compatible aliases supported by NuxtHub:
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# ─── GitHub ─────────────────────────────────────
# Personal access token or GitHub App installation token with repo read/write
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Vercel ───────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=your_blob_storage_token_here
